# Copy to .env (never commit .env)

# Without a key the demo runs in typing-only mode.
OPENAI_API_KEY=

# Optional overrides (defaults in config_data.js)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_ASR_MODEL=gpt-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TTS_FORMAT=pcm           # pcm = streamed (fastest), mp3 = one file per sentence
# OPENAI_REASONING_EFFORT=        # only for reasoning models, e.g. minimal
# OPENAI_BASE_URL=https://api.openai.com/v1

# VOICE_PROVIDER=auto             # auto | openai | mock
# VOICE_MAX_TURNS_PER_DAY=3000    # whole-server daily cap, 0 = unlimited
# VOICE_MAX_TURNS_PER_IP_PER_HOUR=200
# VOICE_TRUST_PROXY=1             # behind Render / Heroku / nginx: use X-Forwarded-For
# VOICE_LOG_LEVEL=info            # info | warn | error | silent
# PORT=8787
